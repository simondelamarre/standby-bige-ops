{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simondelamarre/standby-bige-ops/schemas/manifest.schema.json",
  "title": "standby manifest",
  "description": "What the guardian is allowed to drive, in wake order. Generated by bige-ops. Sleep runs the waves in reverse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stack", "provider", "waves", "app_probe"],
  "properties": {
    "version": { "const": 1 },
    "stack": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider": { "enum": ["docker", "outscale"] },
    "waves": {
      "description": "Each wave starts only once the previous one is running and its probes pass.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/resource" }
      }
    },
    "app_probe": {
      "description": "Checked last; once it passes, the load balancer gets the app back.",
      "$ref": "#/$defs/probe"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "probe": { "$ref": "#/$defs/probe" },
        "hourly_eur": { "type": "number", "minimum": 0 }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["tcp", "http"] },
        "target": {
          "description": "host:port for tcp, an http(s) URL for http.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
